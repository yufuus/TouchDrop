    <!-- Mode 1: Même Wi-Fi -->
    <string name="help_wifi_slide1_badge">MÊME WI-FI • ÉTAPE 1</string>
    <string name="help_wifi_slide1_title">1. Choisissez un fichier</string>
    <string name="help_wifi_slide1_desc">Sélectionnez n\'importe quelle photo, vidéo ou fichier. TouchDrop prépare le streaming local instantanément.</string>

    <string name="help_wifi_slide2_badge">MÊME WI-FI • ÉTAPE 2 (UN SEUL CONTACT)</string>
    <string name="help_wifi_slide2_title">2. Rapprochez une seule fois !</string>
    <string name="help_wifi_slide2_desc">Sur le même Wi-Fi, UN SEUL CONTACT suffit ! Rapprochez les appareils dos à dos ; la page s\'ouvre et le fichier se télécharge à vitesse gigabit.</string>

    <string name="help_wifi_slide3_badge">MÊME WI-FI • ÉTAPE 3 (ZÉRO INSTALLATION)</string>
    <string name="help_wifi_slide3_title">3. Téléchargement direct dans le navigateur</string>
    <string name="help_wifi_slide3_desc">Aucune application requise sur l\'autre téléphone ! Que ce soit iPhone (Safari) ou Android (Chrome), téléchargement direct via navigateur.</string>

    <!-- Mode 2: Pont Rapide -->
    <string name="help_bridge_slide1_badge">PONT RAPIDE • 1ER CONTACT (CONNEXION)</string>
    <string name="help_bridge_slide1_title">1er Contact : Connexion au Wi-Fi</string>
    <string name="help_bridge_slide1_desc">En déplacement sans Wi-Fi partagé, rapprochez les téléphones DEUX FOIS. Le 1ER CONTACT connecte le récepteur à votre pont.</string>

    <string name="help_bridge_slide2_badge">PONT RAPIDE • 2ÈME CONTACT (TÉLÉCHARGEMENT)</string>
    <string name="help_bridge_slide2_title">2ème Contact : Démarrer le transfert</string>
    <string name="help_bridge_slide2_desc">Une fois connecté, rapprochez une SECONDE FOIS. Le navigateur s\'ouvre automatiquement et le fichier se transfère !</string>

    <string name="help_bridge_slide3_badge">PONT RAPIDE • ÉTAPE 3 (ZÉRO INSTALLATION)</string>
    <string name="help_bridge_slide3_title">3. Téléchargement direct dans le navigateur</string>
    <string name="help_bridge_slide3_desc">Ni données mobiles ni application requise sur le récepteur. Transfert direct à haute vitesse.</string>
