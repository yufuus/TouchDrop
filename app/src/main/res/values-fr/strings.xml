    <string name="perm_nfc_title">NFC (Communication en champ proche)</string>
    <string name="perm_nfc_desc">Transfère le lien de téléchargement instantanément au contact. Ne tourne jamais en arrière-plan.</string>
    <string name="perm_wifi_title">Wi-Fi &amp; Réseau Local</string>
    <string name="perm_wifi_desc">Transfère les fichiers directement entre appareils à vitesse gigabit sans aucun cloud.</string>
    <string name="perm_hotspot_title">Pont Rapide &amp; Appareils à proximité</string>
    <string name="perm_hotspot_desc">Crée un pont local sécurisé et chiffré en déplacement quand aucun Wi-Fi n\'est disponible.</string>
    <string name="perm_storage_title">Stockage et Accès aux Fichiers</string>
    <string name="perm_storage_desc">Accède uniquement aux fichiers sélectionnés et enregistre dans \'Téléchargements/TouchDrop\'.</string>

    <string name="legal_p2p_title">100% Peer-to-Peer (Zéro Cloud)</string>
    <string name="legal_p2p_desc">Tous les transferts se font directement entre appareils sur le réseau local sans aucun serveur externe.</string>
    <string name="legal_kvkk_title">Conforme RGPD &amp; Confidentialité</string>
    <string name="legal_kvkk_desc">Aucune donnée personnelle ne quitte votre appareil, garantissant une conformité totale au RGPD.</string>
    <string name="legal_notrack_title">Zéro Collecte de Données</string>
    <string name="legal_notrack_desc">Aucun suivi, aucune télémétrie ni cookie. Basé sur une architecture open source transparente.</string>

