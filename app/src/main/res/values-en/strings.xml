    <string name="perm_nfc_title">NFC (Near Field Communication)</string>
    <string name="perm_nfc_desc">Transfers the download URL instantly when devices touch. Never runs in background.</string>
    <string name="perm_wifi_title">Wi-Fi &amp; Local Network</string>
    <string name="perm_wifi_desc">Transfers files directly between two devices over local network at gigabit speed without cloud.</string>
    <string name="perm_hotspot_title">Quick Bridge &amp; Nearby Devices</string>
    <string name="perm_hotspot_desc">Creates a temporary, encrypted, high-speed local P2P bridge when no Wi-Fi is available.</string>
    <string name="perm_storage_title">Storage &amp; File Access</string>
    <string name="perm_storage_desc">Only accesses the file you choose to send and saves incoming files to \'Downloads/TouchDrop\'.</string>

    <string name="legal_p2p_title">100% Peer-to-Peer (Zero Cloud)</string>
    <string name="legal_p2p_desc">All transfers occur directly between devices over the local network. No file or metadata touches external servers.</string>
    <string name="legal_kvkk_title">GDPR &amp; KVKK Compliant</string>
    <string name="legal_kvkk_desc">Zero personal data leaves your device, ensuring complete privacy compliance under GDPR and KVKK.</string>
    <string name="legal_notrack_title">Zero Data Collection &amp; Open Source</string>
    <string name="legal_notrack_desc">No user tracking, telemetry, cookies, or analytics. Built on transparent, verifiable open-source technology.</string>

    <!-- Help Screen: Titles and 2-Line Non-Overflowing Tabs -->
    <string name="help_title_main">How to Use TouchDrop</string>
    <string name="help_tab_wifi_title">Same Wi-Fi</string>
    <string name="help_tab_wifi_sub">Single Tap</string>
    <string name="help_tab_bridge_title">Quick Bridge</string>
    <string name="help_tab_bridge_sub">Two Taps</string>

    <!-- Mode 1: Same Wi-Fi Slides -->
    <string name="help_wifi_slide1_badge">SAME WI-FI • STEP 1</string>
    <string name="help_wifi_slide1_title">1. Select Your File</string>
    <string name="help_wifi_slide1_desc">Choose any photo, video, or document to share. TouchDrop instantly prepares local P2P streaming.</string>

    <string name="help_wifi_slide2_badge">SAME WI-FI • STEP 2 (SINGLE TAP)</string>
    <string name="help_wifi_slide2_title">2. Tap Devices Once!</string>
    <string name="help_wifi_slide2_desc">When on the same Wi-Fi, A SINGLE TAP is all you need! Hold phones back-to-back once; download page opens and file transfers at gigabit speed.</string>

    <string name="help_wifi_slide3_badge">SAME WI-FI • STEP 3 (ZERO INSTALL)</string>
    <string name="help_wifi_slide3_title">3. Receiver Downloads via Browser</string>
    <string name="help_wifi_slide3_desc">Zero app install needed on the other phone! Whether iPhone (Safari) or Android (Chrome), the file downloads directly in the browser.</string>

    <!-- Mode 2: Quick Bridge Slides -->
    <string name="help_bridge_slide1_badge">QUICK BRIDGE • 1ST TAP (CONNECT)</string>
    <string name="help_bridge_slide1_title">1st Tap: Connect to Wi-Fi</string>
    <string name="help_bridge_slide1_desc">Outdoors with no shared Wi-Fi, tap phones TWICE. The FIRST TAP automatically connects the receiver to your hotspot (\'Wi-Fi Transmitted\').</string>

    <string name="help_bridge_slide2_badge">QUICK BRIDGE • 2ND TAP (DOWNLOAD)</string>
    <string name="help_bridge_slide2_title">2nd Tap: Start Transfer</string>
    <string name="help_bridge_slide2_desc">Once connected to the hotspot, tap phones A SECOND TIME. The download page opens automatically and the file transfers directly!</string>

    <string name="help_bridge_slide3_badge">QUICK BRIDGE • STEP 3 (ZERO INSTALL)</string>
    <string name="help_bridge_slide3_title">3. Receiver Downloads via Browser</string>
    <string name="help_bridge_slide3_desc">No mobile data or app needed on the receiver phone. The file transfers over the high-speed local P2P bridge directly.</string>
