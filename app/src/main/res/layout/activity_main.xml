<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:padding="20dp">

    <!-- Üst Bar: Sadece Başlık ve Bilgi (i) Butonu (Sürüm bilgisi kaldırıldı) -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.03"
            android:text="TouchDrop"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Minimalist Ayarlar Butonu -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="@string/settings_title"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_primary" />

        <!-- Minimalist Bilgi (i) Butonu -->
        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="Bilgi ve Yardım"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Belirgin 2'li Mod Seçici (Segmented Mode Switcher) -->
    <LinearLayout
        android:id="@+id/layoutModeSelector"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader">

        <!-- Mod 1: Aynı Wi-Fi (Ev & Ofis) -->
        <LinearLayout
            android:id="@+id/btnModeWifi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivModeWifi"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_wifi"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvModeWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Aynı Wi-Fi"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mod 2: Hızlı Köprü (Dışarıda / Farklı Ağlar) -->
        <LinearLayout
            android:id="@+id/btnModeHotspot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivModeHotspot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_hotspot"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvModeHotspot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Hızlı Köprü"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Aktif Mod Açıklama Altlığı (Hızlı Rehber) -->
    <TextView
        android:id="@+id/tvModeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• Ev / Ofis: İki telefon da aynı Wi-Fi ağındayken tek dokunuş yeterli."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutModeSelector" />

    <!-- Ana Kahraman Durum Kartı (Obsidian Glassmorphism Hero) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSelectFile"
        app:layout_constraintTop_toBottomOf="@+id/tvModeHint"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <!-- NFC İkon Kutusu -->
                <FrameLayout
                    android:id="@+id/layoutIconContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_pill"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/ivNfc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_nfc"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <!-- Alternatif QR Kod Alanı (Gerekirse) -->
                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="#FFFFFF"
                    android:padding="8dp"
                    android:visibility="gone" />

                <!-- Büyük, Net Ana Durum Başlığı -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="1. Dosya Seçin"
                    android:textAlignment="center"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <!-- Açıklayıcı Alt Başlık / Yönlendirme -->
                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Paylaşmak istediğiniz dosyayı seçin, ardından telefonları dokundurun."
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Seçili Dosya Kutusu (Pill) -->
                <LinearLayout
                    android:id="@+id/layoutSelectedFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_file"
                        app:tint="@color/accent_emerald" />

                    <TextView
                        android:id="@+id/tvSelectedFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Dosya seçilmedi"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Gelen Dosyayı Aç Butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenReceived"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/btn_primary_bg"
                    android:text="Gelen Dosyayı Aç"
                    android:textColor="@color/btn_primary_text"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:cornerRadius="100dp"
                    app:icon="@drawable/ic_open_in_new"
                    app:iconPadding="8dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/btn_primary_text" />

                <!-- Tarayıcıda Test Et Butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestInBrowser"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Tarayıcıda Aç"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:cornerRadius="100dp"
                    app:icon="@drawable/ic_open_in_new"
                    app:iconPadding="6dp"
                    app:iconSize="14dp"
                    app:iconTint="@color/text_secondary"
                    app:strokeColor="@color/border_subtle" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dosya Seç Ana Butonu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectFile"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/btn_primary_bg"
        android:fontFamily="sans-serif-medium"
        android:text="Dosya Seç"
        android:textColor="@color/btn_primary_text"
        android:textSize="15sp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_upload"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/btn_primary_text"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
