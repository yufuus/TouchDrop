<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card_border"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Sürükleme Çubuğu (Drag Handle) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill" />

    <!-- Üst Başlık ve Kapat (X) Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvHelpHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="@string/help_title_main"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnCloseHelp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill"
            android:contentDescription="Kapat"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Segmented Mod Sekmeleri: İki Satırlı Taşmayan Kusursuz Butonlar -->
    <LinearLayout
        android:id="@+id/layoutHelpModeTabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <!-- Tab 1: Aynı Wi-Fi -->
        <LinearLayout
            android:id="@+id/btnHelpTabWifi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_mode_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ivHelpTabWifi"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_wifi"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHelpTabWifiTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/help_tab_wifi_title"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvHelpTabWifiSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/help_tab_wifi_sub"
                    android:textColor="@color/accent_emerald"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tab 2: Hızlı Köprü -->
        <LinearLayout
            android:id="@+id/btnHelpTabHotspot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ivHelpTabHotspot"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_hotspot"
                app:tint="@color/text_muted" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHelpTabHotspotTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/help_tab_bridge_title"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvHelpTabHotspotSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/help_tab_bridge_sub"
                    android:textColor="@color/text_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Aktif Hızlı Köprü Bilgisi (Sadece Hotspot açıkken görünür) -->
    <LinearLayout
        android:id="@+id/cardHotspotInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Aktif Köprü Bilgileri"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvHotspotSsid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Ağ: TouchDrop"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHotspotPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="monospace"
                android:text="Şifre: 12345678"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCopyPass"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kopyala"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_copy"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Büyük, Tüm Ekranı Kaplayan ViewPager2 Carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerHelp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp" />

    <!-- Sayfa Gösterge Noktaları (Dots Indicator) -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot0"
            android:layout_width="20dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/dot_active" />

        <View
            android:id="@+id/dot1"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/dot_inactive" />

        <View
            android:id="@+id/dot2"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="3dp"
            android:background="@drawable/dot_inactive" />
    </LinearLayout>

    <!-- Alt Buton Çubuğu (Atla ve İleri / Anladım) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Atla Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipHelp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_skip"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- İleri / Anladım Butonu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextHelp"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/btn_primary_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/btn_next"
            android:textColor="@color/btn_primary_text"
            android:textSize="14sp"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
