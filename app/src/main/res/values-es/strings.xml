    <!-- Modo 1: Mismo Wi-Fi -->
    <string name="help_wifi_slide1_badge">MISMO WI-FI • PASO 1</string>
    <string name="help_wifi_slide1_title">1. Elige tu archivo</string>
    <string name="help_wifi_slide1_desc">Selecciona cualquier foto, video o documento. TouchDrop prepara el streaming local al instante.</string>

    <string name="help_wifi_slide2_badge">MISMO WI-FI • PASO 2 (UN SOLO TOQUE)</string>
    <string name="help_wifi_slide2_title">2. ¡Solo un toque espalda con espalda!</string>
    <string name="help_wifi_slide2_desc">En la misma red Wi-Fi, ¡UN SOLO TOQUE basta! Junta los teléfonos una vez; la página se abre y el archivo se descarga a máxima velocidad.</string>

    <string name="help_wifi_slide3_badge">MISMO WI-FI • PASO 3 (CERO APPS)</string>
    <string name="help_wifi_slide3_title">3. El receptor descarga en el navegador</string>
    <string name="help_wifi_slide3_desc">¡Cero apps en el receptor! Ya sea iPhone (Safari) o Android (Chrome), descarga directamente por navegador.</string>

    <!-- Modo 2: Puente Rápido -->
    <string name="help_bridge_slide1_badge">PUENTE RÁPIDO • 1ER TOQUE (CONECTAR)</string>
    <string name="help_bridge_slide1_title">1er Toque: Conectar al Wi-Fi</string>
    <string name="help_bridge_slide1_desc">Al aire libre sin Wi-Fi, junta los teléfonos DOS VECES. El PRIMER TOQUE conecta el receptor a tu punto de acceso automáticamente.</string>

    <string name="help_bridge_slide2_badge">PUENTE RÁPIDO • 2DO TOQUE (DESCARGA)</string>
    <string name="help_bridge_slide2_title">2do Toque: Iniciar descarga</string>
    <string name="help_bridge_slide2_desc">Una vez conectado, junta los teléfonos POR SEGUNDA VEZ. El navegador se abre automáticamente e inicia la transferencia.</string>

    <string name="help_bridge_slide3_badge">PUENTE RÁPIDO • PASO 3 (CERO APPS)</string>
    <string name="help_bridge_slide3_title">3. El receptor descarga en el navegador</string>
    <string name="help_bridge_slide3_desc">Sin gastar datos móviles ni instalar apps. El archivo viaja por el puente local directo a toda velocidad.</string>
