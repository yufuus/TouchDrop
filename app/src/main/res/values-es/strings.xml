    <string name="perm_nfc_title">NFC (Comunicación de Campo Cercano)</string>
    <string name="perm_nfc_desc">Transfiere el enlace de descarga al instante al tocar los teléfonos. Nunca funciona en segundo plano.</string>
    <string name="perm_wifi_title">Wi-Fi y Red Local</string>
    <string name="perm_wifi_desc">Transfiere archivos directamente entre dispositivos a velocidad gigabit sin pasar por la nube.</string>
    <string name="perm_hotspot_title">Puente Rápido y Dispositivos Cercanos</string>
    <string name="perm_hotspot_desc">Crea un puente local temporal y cifrado cuando no hay Wi-Fi disponible.</string>
    <string name="perm_storage_title">Almacenamiento y Acceso a Archivos</string>
    <string name="perm_storage_desc">Solo accede al archivo que seleccionas y guarda los archivos recibidos en \'Descargas/TouchDrop\'.</string>

    <string name="legal_p2p_title">100% Peer-to-Peer (Cero Nube)</string>
    <string name="legal_p2p_desc">Todas las transferencias ocurren directamente entre teléfonos. Ningún dato toca servidores externos.</string>
    <string name="legal_kvkk_title">Cumplimiento RGPD y Privacidad</string>
    <string name="legal_kvkk_desc">Ningún dato personal sale de tu dispositivo, garantizando total cumplimiento con el RGPD.</string>
    <string name="legal_notrack_title">Cero Recopilación de Datos</string>
    <string name="legal_notrack_desc">Sin rastreo, telemetría ni cookies. Desarrollado con tecnología de código abierto transparente.</string>

