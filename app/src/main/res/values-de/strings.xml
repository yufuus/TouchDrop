    <string name="perm_nfc_title">NFC (Nahfeldkommunikation)</string>
    <string name="perm_nfc_desc">Überträgt den Download-Link sofort bei Berührung. Läuft nie im Hintergrund.</string>
    <string name="perm_wifi_title">WLAN &amp; Lokales Netzwerk</string>
    <string name="perm_wifi_desc">Überträgt Dateien direkt zwischen Geräten im lokalen Netz in Gigabit-Geschwindigkeit ohne Cloud.</string>
    <string name="perm_hotspot_title">Schnellbrücke &amp; Geräte in der Nähe</string>
    <string name="perm_hotspot_desc">Erstellt eine temporäre, verschlüsselte lokale Brücke, wenn kein WLAN verfügbar ist.</string>
    <string name="perm_storage_title">Speicher- und Dateizugriff</string>
    <string name="perm_storage_desc">Greift nur auf ausgewählte Dateien zu und speichert empfangene Dateien unter \'Downloads/TouchDrop\'.</string>

    <string name="legal_p2p_title">100% Peer-to-Peer (Keine Cloud)</string>
    <string name="legal_p2p_desc">Alle Dateiübertragungen laufen direkt zwischen Geräten. Keine Datei oder Metadaten berühren externe Server.</string>
    <string name="legal_kvkk_title">DSGVO &amp; Datenschutz-Konform</string>
    <string name="legal_kvkk_desc">Es verlassen keine personenbezogenen Daten das Gerät – vollständig DSGVO-konform.</string>
    <string name="legal_notrack_title">Keine Datenerfassung &amp; Open Source</string>
    <string name="legal_notrack_desc">Kein Tracking, keine Telemetrie, keine Cookies. Vollständig transparente Open-Source-Technologie.</string>

