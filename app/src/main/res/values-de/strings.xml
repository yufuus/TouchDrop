    <!-- Modus 1: Gleiches WLAN -->
    <string name="help_wifi_slide1_badge">GLEICHES WLAN • SCHRITT 1</string>
    <string name="help_wifi_slide1_title">1. Datei auswählen</string>
    <string name="help_wifi_slide1_desc">Wählen Sie ein Foto, Video oder Dokument. TouchDrop bereitet das lokale P2P-Streaming sofort vor.</string>

    <string name="help_wifi_slide2_badge">GLEICHES WLAN • SCHRITT 2 (1 BERÜHRUNG)</string>
    <string name="help_wifi_slide2_title">2. Nur 1x aneinanderhalten!</string>
    <string name="help_wifi_slide2_desc">Im selben WLAN reicht eine einzige Berührung! Telefone Rücken an Rücken halten; die Download-Seite öffnet sich sofort.</string>

    <string name="help_wifi_slide3_badge">GLEICHES WLAN • SCHRITT 3</string>
    <string name="help_wifi_slide3_title">3. Empfänger lädt im Browser</string>
    <string name="help_wifi_slide3_desc">Keine App beim Empfänger nötig! Egal ob iPhone (Safari) oder Android (Chrome), der Download startet direkt im Browser.</string>

    <!-- Modus 2: Schnellbrücke -->
    <string name="help_bridge_slide1_badge">SCHNELLBRÜCKE • 1. BERÜHRUNG (VERBINDUNG)</string>
    <string name="help_bridge_slide1_title">1. Berührung: WLAN verbinden</string>
    <string name="help_bridge_slide1_desc">Unterwegs ohne WLAN 2x aneinanderhalten. Die ERSTE Berührung verbindet den Empfänger automatisch mit Ihrem Hotspot.</string>

    <string name="help_bridge_slide2_badge">SCHNELLBRÜCKE • 2. BERÜHRUNG (DOWNLOAD)</string>
    <string name="help_bridge_slide2_title">2. Berührung: Download starten</string>
    <string name="help_bridge_slide2_desc">Sobald verbunden, ein ZWEITES MAL aneinanderhalten. Der Browser öffnet sich automatisch und überträgt die Datei!</string>

    <string name="help_bridge_slide3_badge">SCHNELLBRÜCKE • SCHRITT 3</string>
    <string name="help_bridge_slide3_title">3. Direkt im Browser laden</string>
    <string name="help_bridge_slide3_desc">Kein Datenvolumen und keine App erforderlich. Dateiübertragung läuft direkt über die Hochgeschwindigkeitsbrücke.</string>
